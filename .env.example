# Local development only. Do not reuse these passwords in production.
TASKPULSE_STORAGE=mysql
TASKPULSE_HTTP_ADDR=:8080
TASKPULSE_BIND_ADDRESS=127.0.0.1
TASKPULSE_INTERNAL_WORKERS_ENABLED=true
TASKPULSE_WORKER_COUNT=1
TASKPULSE_WORKER_LEASE_DURATION=30s
MYSQL_DATABASE=taskpulse
MYSQL_HOST=127.0.0.1
MYSQL_USER=taskpulse
MYSQL_PASSWORD=replace-this-development-password
MYSQL_ROOT_PASSWORD=replace-this-development-root-password
MYSQL_PORT=3306
MYSQL_BIND_ADDRESS=127.0.0.1

# TaskPulse database/sql pool settings.
MYSQL_MAX_OPEN_CONNS=20
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=3m
MYSQL_CONN_MAX_IDLE_TIME=1m
MYSQL_CONNECT_TIMEOUT=5s
MYSQL_READ_TIMEOUT=10s
MYSQL_WRITE_TIMEOUT=10s
MYSQL_PING_TIMEOUT=5s
